class Solution {
    public TreeNode insertIntoBST(TreeNode root, int val) {
        // Case 1: Tree is empty → new node becomes root
        if (root == null) return new TreeNode(val);

        // Pointer to traverse
        TreeNode curr = root;

        while (true) {
            // Case 2: Go to left subtree
            if (val < curr.val) {
                if (curr.left == null) { 
                    curr.left = new TreeNode(val); // Found spot
                    break;
                } else {
                    curr = curr.left; // Go deeper
                }
            } 
            // Case 3: Go to right subtree
            else {
                if (curr.right == null) {
                    curr.right = new TreeNode(val); // Found spot
                    break;
                } else {
                    curr = curr.right; // Go deeper
                }
            }
        }

        // Finally return the unchanged root
        return root;
    }
}
