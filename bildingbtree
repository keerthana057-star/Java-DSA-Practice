lass Solution {
    public TreeNode buildTree(int[] inorder, int[] postorder) {
        Map<Integer, Integer> inorderMap = new HashMap<>();
        for (int i = 0; i < inorder.length; i++) {
            inorderMap.put(inorder[i], i);
        }
        // Call recursive helper
        return build(postorder, 0, postorder.length - 1,
                     inorder, 0, inorder.length - 1,
                     inorderMap);
    }

    private TreeNode build(int[] postorder, int postStart, int postEnd,
                           int[] inorder, int inStart, int inEnd,
                           Map<Integer, Integer> inorderMap) {
        if (postStart > postEnd || inStart > inEnd) return null;

        // Root is last element in current postorder range
        int rootVal = postorder[postEnd];
        TreeNode root = new TreeNode(rootVal);

        // Index of root in inorder
        int inRoot = inorderMap.get(rootVal);
        int leftSize = inRoot - inStart;
        int rightSize = inEnd - inRoot;

        // Build left subtree
        root.left = build(postorder, postStart, postStart + leftSize - 1,
                          inorder, inStart, inRoot - 1,
                          inorderMap);

        // Build right subtree
        root.right = build(postorder, postEnd - rightSize, postEnd - 1,
                           inorder, inRoot + 1, inEnd,
                           inorderMap);

        return root;
    }
}
