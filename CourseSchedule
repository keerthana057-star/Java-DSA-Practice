class Solution {
    public boolean canFinish(int numCourses, int[][] prerequisites) {
         
         // Build adjacency list
        List<List<Integer>> adj = new ArrayList<>();
        for (int i = 0; i < numCourses; i++) adj.add(new ArrayList<>());
        for (int[] pre : prerequisites) adj.get(pre[1]).add(pre[0]);
        
        boolean[] visited = new boolean[numCourses]; // marks visited nodes
        boolean[] path = new boolean[numCourses];    // tracks recursion stack for cycle detection
        
        // Check each course
        for (int i = 0; i < numCourses; i++) {
            if (!visited[i]) {
                if (dfs(i, visited, path, adj)) return false; // cycle found → cannot finish
            }
        }
        return true; // no cycle → can finish all courses
    }
    
    private boolean dfs(int node, boolean[] visited, boolean[] path, List<List<Integer>> adj) {
        visited[node] = true;
        path[node] = true;
        
        for (int nei : adj.get(node)) {
            if (!visited[nei]) {
                if (dfs(nei, visited, path, adj)) return true; // cycle found in deeper DFS
            } else if (path[nei]) {
                return true; // back edge → cycle detected
            }
        }
        
        path[node] = false; // backtrack
        return false; // no cycle found from this node
    }
    
}
    
