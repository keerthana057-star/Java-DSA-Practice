class Solution {
    public int[] findOrder(int numCourses, int[][] prerequisites) {
           // Step 1: Build adjacency list and indegree array
        List<List<Integer>> adj = new ArrayList<>();
        for (int i = 0; i < numCourses; i++) adj.add(new ArrayList<>());
        int[] indegree = new int[numCourses];

        for (int[] pre : prerequisites) {
            int course = pre[0];
            int prereq = pre[1];
            adj.get(prereq).add(course); // prereq → course
            indegree[course]++;
        }

        // Step 2: Add all courses with indegree 0 to queue
        Queue<Integer> q = new LinkedList<>();
        for (int i = 0; i < numCourses; i++)
            if (indegree[i] == 0) q.add(i);

        // Step 3: Process courses
        int[] topo = new int[numCourses];
        int idx = 0;

        while (!q.isEmpty()) {
            int node = q.poll();
            topo[idx++] = node;

            for (int nei : adj.get(node)) {
                indegree[nei]--;
                if (indegree[nei] == 0) q.add(nei);
            }
        }

        // Step 4: Check if all courses processed
        if (idx != numCourses) return new int[0]; // cycle exists
        return topo;
    }
}
    
