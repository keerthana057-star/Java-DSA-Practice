class Solution {
    public void solve(char[][] board) {
        if(board==null || board.length==0 || board[0].length==0) return ;


        //set the board
        int n =  board.length;
        int m = board[0].length;
        int[][]visited = new int[n][m];
        int[][]directions = {{-1,0},{1,0},{0,-1},{0,1}};

        //loop first col and last col
        for(int i=0;i<n;i++){
            if(board[i][0]=='O' && visited[i][0]==0){
                dfs(i,0,board,visited,directions);
            }
            if(board[i][m-1]=='O' && visited[i][m-1]==0){
                dfs(i,m-1,board,visited,directions);
            }
        }
        for(int j=0;j<m;j++){
             if(board[0][j]=='O' && visited[0][j]==0){
                dfs(0,j,board,visited,directions);
            }
            if(board[n-1][j]=='O' && visited[n-1][j]==0){
                dfs(n-1,j,board,visited,directions);
            }
        }

        //flip
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                if(board[i][j]=='O'&&visited[i][j]==0)board[i][j]='X';
            }
        }
    }

        private void dfs(int r,int c,char[][]board,int[][]visited,int[][]directions){
            int n =  board.length;
            int m = board[0].length;
            visited[r][c]=1;

            for(int[]dir:directions){
                int nr=r+dir[0];
                int nc=c+dir[1];

                if(nr>=0 && nr<n && nc>=0 && nc<m && board[nr][nc]=='O' && visited[nr][nc]==0){
                    dfs(nr,nc,board,visited,directions);
                }
            }
        
        
    }
}
